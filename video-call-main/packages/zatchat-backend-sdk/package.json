{
  "name": "@zatchat/backend-sdk",
  "version": "0.1.0",
  "description": "Backend SSO route factory for integrating external apps with ZatChat",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --watch --format cjs,esm --dts",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "chat",
    "sso",
    "sdk",
    "zatchat",
    "express"
  ],
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "tsup": "^8.3.5",
    "typescript": "^5.8.3"
  }
}
